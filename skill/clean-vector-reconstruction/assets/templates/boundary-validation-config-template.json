{
  "version": 1,
  "fullRenderSize": {
    "width": null,
    "height": null
  },
  "analysisSize": {
    "maxDimension": 1000
  },
  "preprocessing": {
    "blurRadius": 0.8
  },
  "extraction": {
    "colorSpace": "CIELAB-D65",
    "gradientOperator": "sobel-3x3",
    "nonMaximumSuppression": true,
    "thresholdMethod": "reference-otsu",
    "thresholdFloor": 4.0,
    "highPercentileClip": 99.5,
    "lowHighRatio": 0.5,
    "minimumComponentSize": 6
  },
  "tolerancesFullPixels": [2, 4, 8],
  "maxRegions": 8,
  "output": {
    "writeCsv": true,
    "boundaryMaps": true,
    "mismatchVisualizations": true,
    "visualizationToleranceFullPixels": 4
  }
}
